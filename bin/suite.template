#!/bin/sh
# Rendered by install.sh: @SUITE_LIB_DIR@ and @SUITE_VERSION@ are substituted
# at install time. POSIX sh, because this file must answer --version even on a
# machine where bun is not installed yet.
set -eu

SUITE_LIB_DIR="@SUITE_LIB_DIR@"
SUITE_VERSION="@SUITE_VERSION@"
export SUITE_LIB_DIR SUITE_VERSION

case "${1:-}" in
--version | -V)
	printf '%s\n' "$SUITE_VERSION"
	exit 0
	;;
esac

# ---------------------------------------------------------------- bun ------
# `suite init` is the one verb whose whole job is to set a cold machine up, and
# the CLI it lives in is written in TypeScript. Refusing to run it because bun
# is missing makes its own bun-detect-and-offer path unreachable on exactly the
# machine state it exists for -- and `suite init` is the next command install.sh
# prints. So when bun is absent AND the verb is `init`, this POSIX bootstrap
# makes the same offer in shell, then re-execs the real CLI.
#
# No sudo, ever: the bun.sh installer writes to $BUN_INSTALL (default ~/.bun),
# which the user owns. The install is OFFERED, never silent.
bun_bin_dir() {
	printf '%s/bin' "${BUN_INSTALL:-$HOME/.bun}"
}

# Reads one line, preferring the controlling terminal: stdin may be a pipe.
suite_ask() {
	_reply=""
	if [ -r /dev/tty ] && [ -t 0 ]; then
		IFS= read -r _reply </dev/tty || _reply=""
	else
		IFS= read -r _reply || _reply=""
	fi
	printf '%s' "$_reply"
}

# ------------------------------------------------------- machine callers ---
# A caller that passes --json (the Mac app) gets ONE JSON document on stdout
# and an exit code, and is NEVER prompted: nothing here reads /dev/tty or stdin
# on that path. With bun absent that document is the `suite init --json`
# shape, blocked (exit 3) on one human step, install_bun, naming the official
# command and page. `suite secret` is always a machine verb, so it counts too.
# `--install-bun` is the explicit consent: it runs the same official bootstrap
# below without a prompt.
SUITE_JSON=0
SUITE_INSTALL_BUN=0
for _arg in "$@"; do
	case "$_arg" in
	--) break ;;
	--json) SUITE_JSON=1 ;;
	--install-bun) SUITE_INSTALL_BUN=1 ;;
	esac
done
case "${1:-}" in
secret) SUITE_JSON=1 ;;
esac

BUN_INSTALL_COMMAND='curl -fsSL https://bun.sh/install | bash'
BUN_INSTALL_URL='https://bun.sh/docs/installation'

# The tmux half of the deps object. Present/absent and the path, nothing else.
tmux_json() {
	_tmux="$(command -v tmux 2>/dev/null || true)"
	case "$_tmux" in
	'' | *\"* | *\\*) printf '{"present": false, "version": null, "path": null}' ;;
	*) printf '{"present": true, "version": null, "path": "%s"}' "$_tmux" ;;
	esac
}

# Exit 3 with the one document. Field order is init_ref.ts INIT_RESULT_FIELDS.
emit_bun_missing() {
	cat <<EOF_JSON
{
  "contract_version": 1,
  "ok": false,
  "changed": false,
  "connection": {
    "suite_url": "",
    "runtime_id": "",
    "token_ref": null,
    "keychain_service": null
  },
  "deps": {
    "bun": {"present": false, "version": null, "path": null},
    "tmux": $(tmux_json)
  },
  "watchdog": {
    "requested": false,
    "installed": null,
    "kind": null,
    "summary": null
  },
  "human_steps": [
    {
      "kind": "install_bun",
      "text": "bun is not installed. The suite CLI runs on bun. Install it with the official installer, then try again.",
      "command": "$BUN_INSTALL_COMMAND",
      "url": "$BUN_INSTALL_URL"
    }
  ],
  "error": {
    "code": "bun_missing",
    "message": "bun is not installed or not on PATH"
  }
}
EOF_JSON
	exit 3
}

bootstrap_bun() {
	if [ "$SUITE_INSTALL_BUN" -eq 1 ]; then
		# Consent was given on the command line. No prompt, no /dev/tty.
		printf 'suite: bun is not installed; installing it with the official installer from https://bun.sh (--install-bun).\n' >&2
	else
		printf 'suite: bun is not installed, and suite init needs it.\n' >&2
		printf 'install bun now with the official installer from https://bun.sh? [y/N] ' >&2
		reply="$(suite_ask)"
		printf '\n' >&2
		case "$reply" in
		y | Y | yes | YES | Yes) : ;;
		*)
			printf 'suite: not installing bun. Install it from https://bun.sh, then re-run suite init.\n' >&2
			exit 1
			;;
		esac
	fi

	# unzip belongs on this list because the bun.sh installer downloads a zip
	# and unzips it: without unzip the installer fails partway, leaving a
	# confusing error from someone else's script instead of a named
	# precondition from ours. It is CHECKED, never installed -- installing it
	# would mean a package manager, which means root, and this file's contract
	# is "no sudo, ever". A fix whose failure mode is invisible to a root
	# container and fatal for an unprivileged user is the wrong fix, so we say
	# what is missing and stop.
	for tool in curl bash unzip; do
		if ! command -v "$tool" >/dev/null 2>&1; then
			printf 'suite: %s is needed to install bun, and is not on PATH.\n' "$tool" >&2
			printf 'suite: install %s yourself (suite never runs a package manager, and never sudo), then re-run suite init.\n' \
				"$tool" >&2
			[ "$SUITE_JSON" -eq 1 ] && emit_bun_missing
			exit 127
		fi
	done

	# Downloaded to a file and then run, rather than piped straight into bash:
	# in POSIX sh a pipeline reports only the LAST command's status, so
	# `curl ... | bash` exits 0 when the download fails and bash reads nothing.
	installer="$(mktemp "${TMPDIR:-/tmp}/suite-bun-install.XXXXXX")" ||
		{
			printf 'suite: could not create a temporary file for the bun installer.\n' >&2
			exit 1
		}
	# Installs under $BUN_INSTALL (default ~/.bun), which the user owns. Never sudo.
	# The installer's own chatter goes to stderr: under --json stdout carries
	# exactly one document, from the CLI this execs into.
	if ! curl -fsSL https://bun.sh/install -o "$installer" || ! bash "$installer" >&2; then
		rm -f "$installer"
		printf 'suite: installing bun failed. See https://bun.sh for manual instructions.\n' >&2
		[ "$SUITE_JSON" -eq 1 ] && emit_bun_missing
		exit 1
	fi
	rm -f "$installer"

	PATH="$(bun_bin_dir):$PATH"
	export PATH
	if ! command -v bun >/dev/null 2>&1; then
		printf 'suite: bun was installed but is still not on PATH. Add %s to PATH and re-run.\n' \
			"$(bun_bin_dir)" >&2
		exit 127
	fi
	printf 'suite: bun installed.\n' >&2
}

if ! command -v bun >/dev/null 2>&1; then
	# A previous bootstrap may already have put bun in its default location
	# without the user's PATH catching up yet.
	if [ -x "$(bun_bin_dir)/bun" ]; then
		PATH="$(bun_bin_dir):$PATH"
		export PATH
	fi
fi

if ! command -v bun >/dev/null 2>&1; then
	if [ "$SUITE_INSTALL_BUN" -eq 1 ]; then
		bootstrap_bun
	elif [ "$SUITE_JSON" -eq 1 ]; then
		emit_bun_missing
	fi
fi

if ! command -v bun >/dev/null 2>&1; then
	case "${1:-}" in
	init)
		bootstrap_bun
		;;
	*)
		printf 'suite: bun is not installed or not on PATH.\n' >&2
		printf 'suite needs bun to run. Install it from https://bun.sh, then re-run this command.\n' >&2
		exit 127
		;;
	esac
fi

# Runtime dependencies (package.json "dependencies", e.g. yaml) are not in the
# release tarball. Install them once, into the library directory, the first
# time the launcher runs without them. install.sh does the same when bun is
# already present; this covers installs made before bun existed on the machine.
if [ ! -d "$SUITE_LIB_DIR/node_modules" ] && grep -q '"dependencies"' "$SUITE_LIB_DIR/package.json" 2>/dev/null; then
	printf 'suite: installing runtime dependencies into %s\n' "$SUITE_LIB_DIR" >&2
	(cd "$SUITE_LIB_DIR" && bun install --production >&2) || {
		printf 'suite: could not install runtime dependencies; run: (cd %s && bun install --production)\n' "$SUITE_LIB_DIR" >&2
		exit 1
	}
fi

exec bun "$SUITE_LIB_DIR/src/cli.ts" "$@"
